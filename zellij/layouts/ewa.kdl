layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
    }
    cwd "/home/emily/Projects/ewa/ewa-pricelist/"
    tab name="code" {
        pane {
            command "bash"
            args "-c" "source .venv/bin/activate; nvim .; exec bash"
        }
    }
    tab name="backend" {
        pane cwd="../" {
            command "bash"
            args "-c" "./start.sh; exec bash"
        }
        pane {
            command "bash"
            args "-c" "source .venv/bin/activate; exec bash"
        }
    }
    tab name="frontend" cwd="../ewa-frontend/" {
        pane {
            command "bash"
            args "-c" "npm run dev; exec bash"
        }
    }
}
